#!/usr/bin/env python3
"""airpods-tray — tray icon, tray widget and window for AirPods Pro 3 listening modes.

Pixel-for-pixel implementation of the Figma design: window states "Connected",
"Disconnected" and "Low Battery", the app icon, the tray icon (connected /
disconnected) and the tray widget. Uses PySide6 (Qt 6), which ships with Bazzite.

The app runs on XWayland: on Wayland a client cannot place its own windows, and
the tray widget has to open right under the tray icon.
"""

import json
import os
import sys
import threading
import time

os.environ.setdefault("QT_QPA_PLATFORM", "xcb")

HERE = os.path.dirname(os.path.realpath(__file__))
ASSETS = os.path.join(HERE, "assets")
UI = os.path.join(ASSETS, "ui")
sys.path.insert(0, HERE)
from airpods_aap import (CASE, CMD_ALLOW_OFF_MODE, CMD_ONE_BUD_ANC, LEFT, MODE_TITLES, MODES, RIGHT,  # noqa: E402
                         AirPods, AirPodsError, find_airpods)

from PySide6.QtCore import (Property, QEasingCurve, QObject, QPoint, QPointF,  # noqa: E402
                            QPropertyAnimation, QRectF, QSocketNotifier, Qt, QTimer,
                            QVariantAnimation, Signal)
from PySide6.QtGui import (QColor, QCursor, QFont, QFontDatabase, QFontMetricsF,  # noqa: E402
                           QGuiApplication, QIcon, QImage, QPainter, QPainterPath, QPen,
                           QPixmap, QTransform)
from PySide6.QtNetwork import QLocalServer, QLocalSocket  # noqa: E402
from PySide6.QtSvg import QSvgRenderer  # noqa: E402
from PySide6.QtWidgets import QApplication, QMenu, QWidget  # noqa: E402

import media  # noqa: E402
from sni import TrayItem  # noqa: E402

APP_ID = "airpods-tray"
RECONNECT_MS = 5000
OFF, ANC, TRANSPARENCY = MODES["off"], MODES["anc"], MODES["transparency"]
# Only the two main modes are offered; pressing the active one again turns it off.
MODE_BUTTONS = [ANC, TRANSPARENCY]
LOW_BATTERY = 25  # percent; the "Low Battery" frame shows ~25%
EAR_IN = 0x00     # ear-detection status byte: in ear (0x01 out, 0x02 in case)


