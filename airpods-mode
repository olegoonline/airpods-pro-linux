#!/usr/bin/env python3
"""airpods-mode — switch AirPods Pro 3 listening modes from the command line."""

import argparse
import os
import shutil
import subprocess
import sys

sys.path.insert(0, os.path.dirname(os.path.realpath(__file__)))
from airpods_aap import (DEFAULT_CYCLE, EAR_STATUS, MODE_TITLES, MODES, AirPods,  # noqa: E402
                         AirPodsError, find_airpods, resolve_mode)


def notify(title, body=""):
    if shutil.which("notify-send"):
        subprocess.run(["notify-send", "-a", "AirPods", "-i", "audio-headphones",
                        "-h", "string:x-canonical-private-synchronous:airpods-mode",
                        title, body], check=False)


def cmd_status(pods, args):
    pods.sync()
    print(f"Устройство:  {pods.name or ''} {pods.mac}")
    print(f"Режим:       {MODE_TITLES.get(pods.mode, pods.mode)}")
    if pods.ca is not None:
        print(f"Адапт. к разговору: {'вкл.' if pods.ca else 'выкл.'}")
    print(f"Батарея:     {pods.battery_text()}")
    if pods.ears:
        print(f"Наушники:    {', '.join(EAR_STATUS.get(e, '?') for e in pods.ears)}")
    if args.notify:
        notify(MODE_TITLES.get(pods.mode, "AirPods"), pods.battery_text())


def apply_mode(pods, mode, args):
    result = pods.set_mode(mode)
    title = MODE_TITLES.get(result, str(result))
    if result != mode:
        msg = (f"AirPods ответили режимом «{title}» вместо «{MODE_TITLES[mode]}». "
               "Режим «Выкл.» нужно разрешить в настройках наушников.")
        if args.notify:
            notify("AirPods", msg)
        raise AirPodsError(msg)
    print(f"Режим: {title}")
    if args.notify:
        notify(title, pods.battery_text())


def cmd_set(pods, args):
    apply_mode(pods, resolve_mode(args.mode), args)


def cmd_cycle(pods, args):
    order = [resolve_mode(m) for m in (args.modes or DEFAULT_CYCLE)]
    pods.sync()
    nxt = order[(order.index(pods.mode) + 1) % len(order)] if pods.mode in order else order[0]
    apply_mode(pods, nxt, args)


def cmd_ca(pods, args):
    pods.sync()
    want = {"on": True, "off": False, "toggle": not pods.ca}[args.state]
    result = pods.set_ca(want)
    text = "вкл." if result else "выкл."
    print(f"Адаптация к разговору: {text}")
    if args.notify:
        notify("Адаптация к разговору", text)


def main():
    parser = argparse.ArgumentParser(
        prog="airpods-mode",
        description="Переключение режимов AirPods Pro 3 (протокол AAP из LibrePods). "
                    "Графический интерфейс: airpods-tray.")
    parser.add_argument("-d", "--device", help="MAC-адрес AirPods (по умолчанию — автопоиск)")
    parser.add_argument("-n", "--notify", action="store_true",
                        help="показывать уведомление рабочего стола")
    sub = parser.add_subparsers(dest="command")

    sub.add_parser("status", help="текущий режим и батарея").set_defaults(func=cmd_status)
    for name in MODES:
        sub.add_parser(name, help=f"режим «{MODE_TITLES[MODES[name]]}»").set_defaults(
            func=cmd_set, mode=name)
    p = sub.add_parser("set", help="установить режим по имени")
    p.add_argument("mode")
    p.set_defaults(func=cmd_set)
    p = sub.add_parser("cycle", help="следующий режим по кругу")
    p.add_argument("modes", nargs="*",
                   help=f"порядок режимов (по умолчанию: {' '.join(DEFAULT_CYCLE)})")
    p.set_defaults(func=cmd_cycle)
    p = sub.add_parser("ca", help="адаптация к разговору")
    p.add_argument("state", choices=["on", "off", "toggle"])
    p.set_defaults(func=cmd_ca)

    args = parser.parse_args()
    if not args.command:
        args.command, args.func = "status", cmd_status

    try:
        mac = args.device or find_airpods()
        with AirPods(mac) as pods:
            args.func(pods, args)
    except AirPodsError as e:
        print(f"Ошибка: {e}", file=sys.stderr)
        if args.notify and "ответили" not in str(e):
            notify("AirPods", str(e))
        return 1
    return 0


if __name__ == "__main__":
    sys.exit(main())
