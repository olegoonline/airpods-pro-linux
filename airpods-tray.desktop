[Desktop Entry]
Type=Application
Name=AirPods
GenericName=AirPods Control
Comment=Switch AirPods Pro noise control mode
Icon=airpods-tray
Exec=airpods-tray
Terminal=false
StartupWMClass=airpods-tray
Categories=AudioVideo;Audio;
Keywords=airpods;anc;noise;transparency;headphones;bluetooth;
Actions=cycle;anc;transparency;

[Desktop Action cycle]
Name=Next mode
Exec=airpods-mode --notify cycle

[Desktop Action anc]
Name=Noise Cancellation
Exec=airpods-mode --notify anc

[Desktop Action transparency]
Name=Transparency
Exec=airpods-mode --notify transparency
